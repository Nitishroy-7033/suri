# Jarvis settings. Every option is listed here with its current value; see
# .env.example and backend/config.py for what each one does.

# =========================================================================
# API keys
# =========================================================================
# aistudio.google.com -> "Get API key" -> Create API key in new project
GEMINI_API_KEY=
# console.groq.com -> sign up -> API Keys -> Create
GROQ_API_KEY=
# Only needed if an agent below is switched to that provider.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# =========================================================================
# Server + voice brain
# =========================================================================
HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO
# auto | gemini_live | pipeline | offline
JARVIS_MODE=auto
# The realtime voice brain (not one of the agents below)
GEMINI_LIVE_MODEL=gemini-3.8-live
GEMINI_VOICE=Puck
OLLAMA_HOST=http://127.0.0.1:11434

# =========================================================================
# Models: one per agent. Change any agent's provider / model / key here.
# Providers: openai | groq | openrouter | openai_compat | gemini | ollama | anthropic
# MODEL_KEY empty = use the provider's key above.
# BASE_URL only for openai_compat (e.g. http://127.0.0.1:1234/v1 for LM Studio).
# FALLBACK = models tried in order when this one is rate-limited or down.
# =========================================================================

# Voice LLM (the pipeline brain, used when Gemini Live is unavailable)
VOICE_LLM__PROVIDER=groq
VOICE_LLM__MODEL=qwen/qwen3.8-27b
VOICE_LLM__MODEL_KEY=
VOICE_LLM__FALLBACK=[{"provider":"groq","model":"openai/gpt-oss-20b"},{"provider":"ollama","model":"llama3.2:3b-instruct-q4_K_M"}]

# Web agent (drives Chrome)
WEB_AGENT__PROVIDER=gemini
WEB_AGENT__MODEL=gemini-flash-latest
WEB_AGENT__MODEL_KEY=
WEB_AGENT__FALLBACK=[{"provider":"gemini","model":"gemini-flash-lite-latest"},{"provider":"groq","model":"qwen/qwen3.8-27b"},{"provider":"groq","model":"openai/gpt-oss-20b"}]

# Vision agent (describes camera frames / screenshots)
VISION_AGENT__PROVIDER=gemini
VISION_AGENT__MODEL=gemini-flash-latest
VISION_AGENT__MODEL_KEY=

# Diagnostics agent (status reports + alert wording). gemma4:e2b is already
# pulled here; qwen2.5:1.5b is faster (ollama pull qwen2.5:1.5b), and
# provider=groq makes spoken reports near-instant.
DIAGNOSTICS_AGENT__PROVIDER=ollama
DIAGNOSTICS_AGENT__MODEL=gemma4:e2b
DIAGNOSTICS_AGENT__MODEL_KEY=
DIAGNOSTICS_AGENT__TEMPERATURE=0.4
DIAGNOSTICS_AGENT__MAX_TOKENS=120

# =========================================================================
# Tools
# =========================================================================
# "all", a comma-separated list (get_datetime,web_search), or empty for none.
TOOLS_ENABLED=all
# open_app / open_url / unload_model. Read-only tools are unaffected.
TOOLS_ALLOW_ACTIONS=true
TOOL_TIMEOUT_S=15

# =========================================================================
# Diagnostics (Systems view, "Jarvis, status report", spoken alerts)
# =========================================================================
DIAG_ENABLED=true
DIAG_INTERVAL_S=2
DIAG_ALERTS=true
DIAG_ALERT_COOLDOWN_S=600
DIAG_BATTERY_LOW=20
DIAG_BATTERY_CRITICAL=10
DIAG_TEMP_HOT_C=85
DIAG_RAM_HIGH_PCT=90
DIAG_DISK_LOW_GB=5
DIAG_PING_HOST=1.1.1.1

# =========================================================================
# Camera + motion (needs: pip install opencv-python)
# =========================================================================
CAMERA_ENABLED=false
CAMERA_INDEX=0
MOTION_WATCH_ON_START=false
MOTION_COOLDOWN_S=30

# =========================================================================
# Web agent: drives your Chrome for website jobs
# =========================================================================
WEB_AGENT_ENABLED=true
WEB_AGENT_MAX_STEPS=25
BROWSER_CHANNEL=chrome
# Buy / pay / delete / send / post always ask you first. Keep this on.
BROWSER_CONFIRM_RISKY=true
# Domains it must never open, comma-separated, e.g. bank.com,paypal.com
BROWSER_BLOCKED_DOMAINS=
