# Copy to .env and fill in. Both keys are free and need no credit card.
# Neither is required for Phase 0-1, and offline mode never needs either.

# aistudio.google.com -> "Get API key" -> Create API key in new project
GEMINI_API_KEY=

# console.groq.com -> sign up -> API Keys -> Create
GROQ_API_KEY=

# Only if you point an agent at one of these providers (see below).
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=

# auto | gemini_live | pipeline | offline
JARVIS_MODE=auto

# --- which model each agent uses -----------------------------------------
# Every agent has its own provider / model / key. Providers: openai, groq,
# openrouter, openai_compat (any OpenAI-style server, needs BASE_URL),
# gemini, ollama, anthropic. MODEL_KEY empty = the provider's key above.
# Set only the fields you want to change; the rest keep their defaults.
#
#   voice_llm          the pipeline brain's LLM   (default groq qwen/qwen3.8-27b -> gpt-oss-20b -> ollama)
#   web_agent          drives Chrome              (default gemini flash -> flash-lite -> groq)
#   vision_agent       describes camera frames    (default gemini flash)
#   diagnostics_agent  status reports + alerts    (default ollama qwen2.5:1.5b)
#
# Gemini Live, the realtime voice brain, is separate: GEMINI_LIVE_MODEL.
#
# VOICE_LLM__PROVIDER=groq
# VOICE_LLM__MODEL=qwen/qwen3.8-27b
# VOICE_LLM__MODEL_KEY=
# WEB_AGENT__PROVIDER=openai
# WEB_AGENT__MODEL=gpt-5-mini
# WEB_AGENT__FALLBACK=[{"provider":"groq","model":"openai/gpt-oss-20b"}]
# VISION_AGENT__PROVIDER=anthropic
# VISION_AGENT__MODEL=claude-haiku-4-5
# DIAGNOSTICS_AGENT__PROVIDER=ollama
# DIAGNOSTICS_AGENT__MODEL=qwen2.5:1.5b      # ollama pull qwen2.5:1.5b
# DIAGNOSTICS_AGENT__BASE_URL=http://127.0.0.1:1234/v1   # e.g. LM Studio with openai_compat

HOST=127.0.0.1
PORT=8080
LOG_LEVEL=INFO

# --- agent: tools --------------------------------------------------------
# "all", a comma-separated list (get_datetime,web_search), or empty for none.
TOOLS_ENABLED=all
# open_app / open_url. Read-only tools are unaffected.
TOOLS_ALLOW_ACTIONS=true
# APP_ALLOWLIST={"notepad":"notepad.exe","spotify":"spotify:"}

# --- agent: diagnostics (Systems view, "Jarvis, status report") ---------
# Laptop + Jarvis health every 2 s, and spoken warnings when a threshold is
# crossed. The rules are plain thresholds; the diagnostics model only words
# the warning (a fixed sentence is used if that model is unavailable).
DIAG_ENABLED=true
DIAG_ALERTS=true
DIAG_ALERT_COOLDOWN_S=600
DIAG_BATTERY_LOW=20
DIAG_BATTERY_CRITICAL=10
DIAG_TEMP_HOT_C=85
DIAG_RAM_HIGH_PCT=90
DIAG_DISK_LOW_GB=5

# --- agent: camera + motion ----------------------------------------------
# Needs: .venv\Scripts\python.exe -m pip install opencv-python
# "look" also needs a vision model (VISION_AGENT__*, Gemini by default);
# motion watch is local only.
CAMERA_ENABLED=false
CAMERA_INDEX=0
MOTION_WATCH_ON_START=false
MOTION_COOLDOWN_S=30

# --- agent: web agent (browses sites for you) ----------------------------
# A separate agent drives a real Chrome window: "open YouTube and play lo-fi".
# Uses sites' own WebMCP tools when they publish them (Chrome 149+).
# Needs: .venv\Scripts\python.exe -m pip install playwright  (uses your
# installed Chrome, no download) and a model for itself (WEB_AGENT__*
# above; Gemini by default).
WEB_AGENT_ENABLED=false
WEB_AGENT_MAX_STEPS=25
# Buy / pay / delete / send / post always ask you first. Keep this on.
BROWSER_CONFIRM_RISKY=true
# Domains it must never open, comma-separated: BROWSER_BLOCKED_DOMAINS=bank.com,paypal.com
BROWSER_BLOCKED_DOMAINS=

# --- the holographic workshop (press H, or "Jarvis, open the workshop") --
# A full-screen hologram: 3D models you turn with your hands, floating
# windows for chat, settings, files and PC controls. Hand tracking runs in
# the browser (MediaPipe); the camera is only on while "Hands" is on.
HOLO_ENABLED=true
# Browse and preview files on every drive, ask Jarvis about one, delete to
# the Recycle Bin (only after your yes). Off by default: turning it on lets
# the AI read files you point it at. Windows, Program Files, AppData, .ssh,
# key/.env files and Jarvis's own data are refused regardless.
FS_ENABLED=false
# More to refuse: folder paths or name patterns, e.g. FS_DENY=D:\Private,*.tax
FS_DENY=
# Volume, brightness and media keys, by voice and from the PC panel.
PC_CONTROLS_ENABLED=true
# Finding and generating 3D models. Each is used only once its key is set.
#   POLY_PIZZA_API_KEY  free CC0/CC-BY model search (poly.pizza)  -> forge_find
#   TRIPO_API_KEY / MESHY_API_KEY  paid text/image-to-3D           -> forge_build
#   FORGE_LOCAL_URL  your own Hunyuan3D-2.1 api_server.py, e.g. http://127.0.0.1:8081
#                    (free, needs a 16 GB+ NVIDIA GPU; TRELLIS.2 needs a wrapper
#                    speaking the same /send + /status API). FORGE_IMAGE_MODEL,
#                    a Gemini image model, lets it build from a description too.
POLY_PIZZA_API_KEY=
TRIPO_API_KEY=
MESHY_API_KEY=
FORGE_LOCAL_URL=
FORGE_IMAGE_MODEL=
# Order forge_build tries them in. Paid ones always ask you first.
FORGE_PROVIDERS=local,tripo,meshy
FORGE_REQUIRE_CONFIRM=true
